<t t-name="hbx.event_card">
<t t-set="x_tags" t-value="event.tag_ids.mapped('name')"/>
<t t-set="x_past" t-value="event.is_finished"/>
<t t-set="x_sold" t-value="(not x_past) and (('Sold out' in x_tags) or event.event_registrations_sold_out)"/>
<t t-set="x_partner" t-value="('Partner registration' in x_tags) and event.sudo().organizer_id.website or False"/>
<t t-set="x_partner_name" t-value="event.sudo().organizer_id.name or 'our partner'"/>
<t t-set="x_open" t-value="(not x_past) and (not x_sold) and (not x_partner) and event.event_registrations_open"/>
<t t-set="x_online" t-value="not event.address_id"/>
<t t-set="x_country" t-value="event.sudo().address_id.country_id.name or ''"/>
<t t-set="x_city" t-value="event.sudo().address_id.city or ''"/>
<t t-set="x_loc" t-value="'Online' if x_online else (x_country or x_city)"/>
<t t-set="x_label" t-value="(event.tag_ids.filtered(lambda t: t.category_id.name == 'Card label')[:1].name) or ''"/>
<t t-set="x_type" t-value="(event.tag_ids.filtered(lambda t: t.category_id.name == 'Type')[:1].name) or 'Event'"/>
<t t-set="x_tickets" t-value="event.event_ticket_ids.filtered(lambda t: t.sale_available)"/>
<t t-set="x_prices" t-value="sorted(x_tickets.mapped('price'))"/>
<t t-set="x_fmt" t-value="lambda p: 'S$' + ('{:,.0f}'.format(p) if p == int(p) else '{:,.2f}'.format(p))"/>
<t t-set="x_price" t-value="('Free' if not x_prices[-1] else (x_fmt(x_prices[0]) if x_prices[0] == x_prices[-1] else 'From ' + x_fmt(x_prices[0]))) if x_prices else ('Free' if x_open and not event.event_ticket_ids else '')"/>
<t t-set="x_left" t-value="event.seats_available if (event.seats_limited and event.seats_max) else None"/>
<t t-set="x_url" t-value="'/event/%s/register' % slug(event)"/>
<t t-set="x_bg" t-value="json.loads(event.cover_properties or '{}').get('background-image') or ''"/>
<t t-set="x_img" t-value="x_bg.split('(')[-1].split(')')[0].replace(&quot;'&quot;, '').replace('&quot;', '') if 'url(' in x_bg else '/hb/poster-events.webp'"/>
<t t-set="x_tz" t-value="event.date_tz or 'Asia/Singapore'"/>
<t t-set="x_tzl" t-value="{'Asia/Singapore': 'SGT', 'Europe/Bucharest': 'Bucharest time', 'Asia/Tokyo': 'JST', 'Europe/London': 'UK time'}.get(x_tz, '')"/>
<t t-set="x_tzlong" t-value="{'Asia/Singapore': 'Singapore time', 'Europe/Bucharest': 'Bucharest time', 'Asia/Tokyo': 'Japan time', 'Europe/London': 'UK time'}.get(x_tz, x_tz)"/>
<t t-set="x_start" t-value="event.date_begin.strftime('%Y-%m-%d')"/>
<t t-set="x_end" t-value="event.date_end.strftime('%Y-%m-%d')"/>
<t t-set="x_iso" t-value="event.date_begin.strftime('%Y-%m-%dT%H:%M:%SZ')"/>
<t t-set="x_samemonth" t-value="event.date_begin.month == event.date_end.month and event.date_begin.year == event.date_end.year"/>
<t t-set="x_sameyear" t-value="event.date_begin.year == event.date_end.year"/>
<t t-set="x_img" t-value="{1: '/hb/images/card-event-shaking-online.webp', 2: '/hb/images/card-event-bucharest-module1.webp', 3: '/hb/images/card-event-shaking-to-shaping.webp', 4: '/hb/images/card-event-feminine-masculine.webp', 5: '/hb/images/card-event-body-in-the-room.webp', 6: '/hb/images/card-event-certification-2027.webp', 7: '/hb/images/card-event-transform-practice.webp', 8: '/hb/images/card-event-shaking-to-shaping-sep3.webp', 9: '/hb/images/card-event-internal-alchemy.webp', 10: '/hb/images/card-event-nervous-system.webp', 12: '/hb/images/card-event-breath-as-medicine.webp'}.get(event.id, x_img)"/>
<t t-set="x_cats" t-value="' '.join(sorted(set([{'Singapore': 'singapore', 'Online': 'online', 'Romania': 'international', 'International': 'international', 'Workshop': 'workshops', 'Certification': 'certification'}[n] for n in x_tags if n in {'Singapore': 'singapore', 'Online': 'online', 'Romania': 'international', 'International': 'international', 'Workshop': 'workshops', 'Certification': 'certification'}] + (['online'] if x_online else []))))"/>
<article t-attf-class="evt-card#{' is-sold' if x_sold else ''}#{' is-past' if x_past else ''}" t-att-data-cat="x_cats" t-att-data-start="x_start" t-att-data-end="x_end" t-att-data-sold="'true' if x_sold else None">
  <a class="evt-card-thumb" t-att-href="x_url">
    <span t-if="x_sold" class="evt-sold-badge">Sold Out</span>
    <span t-if="x_past" class="evt-past-badge">Passed</span>
    <img t-att-src="x_img" t-att-alt="event.name" loading="lazy" decoding="async" width="1920" height="1080"/>
  </a>
  <div class="evt-card-content">
    <div class="evt-card-tags"><span class="evt-tag loc" t-out="x_loc"/><span t-if="x_label" class="evt-tag" t-out="x_label"/></div>
    <h3 t-out="event.name"/>
    <div class="evt-dates"><span t-attf-class="evt-date-tag#{' is-closed' if x_sold or x_past else ''}" t-att-data-start="x_start"><t t-if="event.is_one_day"><t t-out="event.date_begin" t-options="{'widget': 'datetime', 'tz_name': x_tz, 'format': 'd MMM y'}"/> · <t t-out="event.date_begin" t-options="{'widget': 'datetime', 'tz_name': x_tz, 'format': 'h:mm'}"/>–<t t-out="event.date_end" t-options="{'widget': 'datetime', 'tz_name': x_tz, 'format': 'h:mm a'}"/><t t-if="x_online and x_tzl"> <t t-out="x_tzl"/></t></t><t t-elif="x_samemonth"><t t-out="event.date_begin" t-options="{'widget': 'datetime', 'tz_name': x_tz, 'format': 'd'}"/>–<t t-out="event.date_end" t-options="{'widget': 'datetime', 'tz_name': x_tz, 'format': 'd MMM y'}"/></t><t t-else=""><t t-out="event.date_begin" t-options="{'widget': 'datetime', 'tz_name': x_tz, 'format': 'd MMM' if x_sameyear else 'd MMM y'}"/> – <t t-out="event.date_end" t-options="{'widget': 'datetime', 'tz_name': x_tz, 'format': 'd MMM y'}"/></t></span></div>
    <p class="evt-card-desc" t-out="event.subtitle"/>
    <p t-if="x_left is not None and x_open" t-attf-class="xev-seats#{' is-low' if x_left &lt;= 5 else ''}"><i class="fa-solid fa-user-group"/> <b t-out="x_left"/> <t t-out="'seat' if x_left == 1 else 'seats'"/> left</p>
    <div class="evt-card-actions">
      <a t-if="x_open" class="hb-btn hb-btn-primary" t-att-href="x_url + '#register-now'">Register<t t-if="x_price and x_price != 'Free' and not x_price.startswith('From')"> — <t t-out="x_price"/></t></a>
      <span t-elif="x_past" class="hb-btn btn-ended">Event Ended</span>
      <span t-elif="x_sold" class="hb-btn btn-soldout">Sold Out</span>
      <a t-elif="x_partner" class="hb-btn hb-btn-primary" t-att-href="x_partner" target="_blank" rel="noopener">Register at <t t-out="x_partner_name"/> →</a>
      <span t-else="" class="hb-btn btn-soldout">Registration closed</span>
      <a class="hb-btn evt-btn-2" t-att-href="x_url"><t t-out="'View Details' if x_open or x_past else 'Details'"/></a>
    </div>
  </div>
</article>
</t>